{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Y4 QDCD parallel-CC qualification evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_evidence",
    "combination_qualifications",
    "driver_programming"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "fixture_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_type_id",
          "rated_current_ma",
          "basis",
          "source_ref_ids"
        ],
        "properties": {
          "fixture_type_id": {
            "type": "string"
          },
          "rated_current_ma": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "basis": {
            "enum": [
              "manufacturer_verified",
              "calculated",
              "unknown"
            ]
          },
          "source_ref_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "combination_qualifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_type_ids",
          "manufacturer_status",
          "manufacturer_evidence_ref_ids",
          "owner_decision_id",
          "project_review_status",
          "emergency_status"
        ],
        "properties": {
          "fixture_type_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "manufacturer_status": {
            "enum": [
              "fixture_combination_verified",
              "general_topology_only",
              "unknown"
            ]
          },
          "manufacturer_evidence_ref_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "owner_decision_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_review_status": {
            "enum": [
              "qualified",
              "pending",
              "rejected"
            ]
          },
          "emergency_status": {
            "enum": [
              "qualified",
              "pending",
              "not_applicable"
            ]
          }
        }
      }
    },
    "driver_programming": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_step_ma",
            "current_step_origin_ma",
            "manufacturer_evidence_ref_ids"
          ],
          "properties": {
            "current_step_ma": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "current_step_origin_ma": {
              "type": "number",
              "minimum": 0
            },
            "manufacturer_evidence_ref_ids": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
