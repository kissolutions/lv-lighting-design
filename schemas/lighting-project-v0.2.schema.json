{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KIS LV Lighting Device Hierarchy v0.2.0 - draft",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "source_documents",
    "drawing_pages",
    "source_references",
    "fixture_types",
    "branch_circuits",
    "light_zones",
    "controllers",
    "control_devices",
    "control_systems",
    "control_groups",
    "backup_supplies",
    "decisions",
    "assumptions",
    "open_items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "model_revision",
        "stage",
        "takeoff_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stage": {
          "enum": [
            "takeoff",
            "provisional",
            "checkpoint"
          ]
        },
        "takeoff_status": {
          "enum": [
            "in_progress",
            "reconciled"
          ]
        }
      }
    },
    "source_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_document"
      },
      "minItems": 1
    },
    "drawing_pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/drawing_page"
      },
      "minItems": 1
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_reference"
      },
      "minItems": 1
    },
    "fixture_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixture_type_v02"
      }
    },
    "branch_circuits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/branch_circuit"
      }
    },
    "light_zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/light_zone"
      }
    },
    "controllers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controller"
      }
    },
    "control_devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_device"
      }
    },
    "control_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_system"
      }
    },
    "control_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control_group"
      },
      "description": "Preserved source control intent and constraints, including MEP source zones. These are not the designed LV light zones or controller-output groups."
    },
    "backup_supplies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/backup_supply"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_item"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "revision",
        "storage_uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "storage_uri": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "drawing_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_document_id",
        "sheet_id",
        "revision",
        "page_index",
        "width_pt",
        "height_pt",
        "pdf_rotation_deg"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "sheet_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pdf_rotation_deg": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_document_id",
        "drawing_page_id",
        "locator",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "drawing_page_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_pt",
        "y_pt"
      ],
      "properties": {
        "x_pt": {
          "type": "number",
          "minimum": 0
        },
        "y_pt": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "affects_ids",
        "source_ref_ids",
        "blocking",
        "status",
        "resolution",
        "decision_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "affects_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "blocking": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "rationale",
        "status",
        "source_ref_ids",
        "assumption_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "provisional",
            "confirmed"
          ]
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assumption_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "source_ref_ids",
        "invalidated_if",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "invalidated_if": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "unverified",
            "confirmed",
            "invalidated"
          ]
        }
      }
    },
    "load": {
      "type": "object",
      "required": [
        "basis",
        "watts",
        "length_ft",
        "reference_length_ft"
      ],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "per_fixture",
            "per_foot",
            "per_reference_length"
          ]
        },
        "watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "length_ft": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reference_length_ft": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "voltage": {
      "type": "object",
      "required": [
        "current_type",
        "nominal_v",
        "min_v",
        "max_v"
      ],
      "additionalProperties": false,
      "properties": {
        "current_type": {
          "enum": [
            "ac",
            "dc",
            null
          ]
        },
        "nominal_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "min_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "control_connection": {
      "type": "object",
      "required": [
        "target_id",
        "interface",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "interface": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "channel": {
      "type": "object",
      "required": [
        "id",
        "label",
        "power_class",
        "validation_profile",
        "voltage",
        "rated_output_watts",
        "design_limit_watts",
        "auxiliary_load_watts",
        "compatibility_group",
        "source_ref_ids",
        "decision_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "power_class": {
          "enum": [
            "class_1",
            "class_2",
            "class_3",
            "class_4",
            null
          ]
        },
        "validation_profile": {
          "enum": [
            "class2_100w_90w_design",
            "product_specific",
            null
          ]
        },
        "voltage": {
          "$ref": "#/$defs/voltage"
        },
        "rated_output_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "design_limit_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "auxiliary_load_watts": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "compatibility_group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validation_profile": {
                "const": "class2_100w_90w_design"
              }
            }
          },
          "then": {
            "properties": {
              "power_class": {
                "const": "class_2"
              },
              "rated_output_watts": {
                "const": 100
              },
              "design_limit_watts": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0,
                "maximum": 90
              }
            }
          }
        }
      ]
    },
    "power_unit": {
      "type": "object",
      "required": [
        "id",
        "label",
        "input_voltage_v",
        "input_phases",
        "lv_power_type",
        "rated_output_watts",
        "rated_input_watts",
        "design_input_watts",
        "aggregate_design_limit_watts",
        "number_of_channels",
        "backup_supply_id",
        "connected_controls",
        "channels",
        "source_ref_ids",
        "decision_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "input_phases": {
          "enum": [
            1,
            3,
            null
          ]
        },
        "lv_power_type": {
          "enum": [
            "class_1",
            "class_2",
            "class_3",
            "class_4",
            "mixed",
            null
          ]
        },
        "rated_output_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "rated_input_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "design_input_watts": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "aggregate_design_limit_watts": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "number_of_channels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "backup_supply_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "connected_controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control_connection"
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "branch_circuit": {
      "type": "object",
      "required": [
        "id",
        "panel_ref",
        "circuit_label",
        "voltage_v",
        "phases",
        "breaker_amps",
        "backup_supply_id",
        "power_units",
        "source_ref_ids",
        "decision_id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "panel_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "circuit_label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "voltage_v": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "phases": {
          "enum": [
            1,
            3,
            null
          ]
        },
        "breaker_amps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "backup_supply_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "power_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/power_unit"
          }
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fixture_type_v02": {
      "type": "object",
      "required": [
        "id",
        "source_mark",
        "description",
        "source_load",
        "manufacturer_options",
        "source_emergency_provision",
        "source_ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_mark": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_load": {
          "$ref": "#/$defs/load"
        },
        "manufacturer_options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "source_emergency_provision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "light": {
      "type": "object",
      "required": [
        "id",
        "label",
        "source",
        "design",
        "source_ref_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "fixture_type_id",
            "drawing_page_id",
            "source_branch_label",
            "source_control_group_labels",
            "source_annotation_id",
            "drawing_anchor"
          ],
